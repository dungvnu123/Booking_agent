# Local development; scripts/setup.ps1 generates a random DB password.
SERVER_ADDR=127.0.0.1:8081
GIN_MODE=debug
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=
DB_MAX_CONNS=10
POSTGRES_USER=abclinic
POSTGRES_DB=abclinic
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
API_PORT=8081
STORAGE_DIR=.data/uploads
ROSTERING_URL=http://localhost:8000
ROSTERING_DOCKER_URL=http://host.docker.internal:8000
ROSTERING_TIMEOUT=30s
# JWT secrets/TTLs will be added when auth is implemented; no fallback secrets.
