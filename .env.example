# Local development; scripts/setup.ps1 generates a random DB password.
SERVER_ADDR=127.0.0.1:8081
GIN_MODE=debug
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=
DB_MAX_CONNS=10
POSTGRES_USER=abclinic
POSTGRES_DB=abclinic
POSTGRES_PASSWORD=
POSTGRES_PORT=55433
API_PORT=8081
STORAGE_DIR=.data/uploads
ROSTERING_URL=http://localhost:8000
ROSTERING_DOCKER_URL=http://host.docker.internal:8000
ROSTERING_TIMEOUT=30s
# scripts/setup.ps1 generates distinct random JWT secrets without replacing existing values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=abclinic-backend
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_ENCRYPTION=starttls.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender display example: Booking App <your-email@gmail.com>
SMTP_FROM=
SMTP_ENCRYPTION=starttls
SMTP_TIMEOUT=10s
EMAIL_VERIFICATION_URL=http://localhost:8081/api/auth/verify-email
EMAIL_VERIFICATION_TTL=15m
EMAIL_RESEND_COOLDOWN=60s
